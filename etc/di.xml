                </item>
                <item name="condition" xsi:type="object">
                    Magebit\McpMarketingTools\Model\FieldResolver\CartRule\ConditionsResolver
                </item>
                <item name="action_condition" xsi:type="object">
                    Magebit\McpMarketingTools\Model\FieldResolver\CartRule\ActionConditionResolver
                </item>
                <item name="action" xsi:type="object">
                    Magebit\McpMarketingTools\Model\FieldResolver\CartRule\ActionResolver
                </item>
                <item name="coupon_settings" xsi:type="object">
                    Magebit\McpMarketingTools\Model\FieldResolver\CartRule\CouponSettingsResolver
                </item>
                <item name="usage" xsi:type="object">
                    Magebit\McpMarketingTools\Model\FieldResolver\CartRule\UsageResolver
                </item>
                <item name="store_labels" xsi:type="object">
                    Magebit\McpMarketingTools\Model\FieldResolver\CartRule\StoreLabelsResolver
                </item>
                <item name="lifecycle" xsi:type="object">
                    Magebit\McpMarketingTools\Model\FieldResolver\CartRule\LifecycleResolver
                </item>
            </argument>
        </arguments>
    </type>

    <type name="Magebit\McpMarketingTools\Tool\Marketing\CartRule\CartRuleList">
        <arguments>
            <argument name="fieldResolvers" xsi:type="array">
                <item name="identity" xsi:type="object">
                    Magebit\McpMarketingTools\Model\FieldResolver\CartRule\IdentityResolver
                </item>
                <item name="scope" xsi:type="object">
                    Magebit\McpMarketingTools\Model\FieldResolver\CartRule\ScopeResolver
                </item>
                <item name="schedule" xsi:type="object">
                    Magebit\McpMarketingTools\Model\FieldResolver\CartRule\ScheduleResolver
                </item>
                <item name="action" xsi:type="object">
                    Magebit\McpMarketingTools\Model\FieldResolver\CartRule\ActionResolver
                </item>
                <item name="coupon_settings" xsi:type="object">
                    Magebit\McpMarketingTools\Model\FieldResolver\CartRule\CouponSettingsResolver
                </item>
                <item name="usage" xsi:type="object">
