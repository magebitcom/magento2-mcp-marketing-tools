                </item>
            </argument>
        </arguments>
    </type>

    <type name="Magebit\McpMarketingTools\Tool\Marketing\CartRule\Coupon\CouponList">
        <arguments>
            <argument name="fieldResolvers" xsi:type="array">
                <item name="identity" xsi:type="object">
                    Magebit\McpMarketingTools\Model\FieldResolver\Coupon\IdentityResolver
                </item>
                <item name="rule" xsi:type="object">
                    Magebit\McpMarketingTools\Model\FieldResolver\Coupon\RuleResolver
                </item>
                <item name="usage" xsi:type="object">
                    Magebit\McpMarketingTools\Model\FieldResolver\Coupon\UsageResolver
                </item>
